# Cell 23: Train final models
lungmodel = LogisticRegression(max_iter=1000, random_state=42)
lungmodel.fit(xtrainlung_smote, ytrainlung_smote)

heartmodel = MLPClassifier(max_iter=2000, hidden_layer_sizes=(100, 50), learning_rate_init=0.01, random_state=42)
