# Cell 11: Transform lung dataset values
columns_to_transform_for_lung = ['smoking', 'yellow_fingers', 'anxiety', 'peer_pressure', 'chronic_disease', 'fatigue_', 'allergy_', 'wheezing', 'alcohol_consuming', 'coughing', 'shortness_of_breath', 'swallowing_difficulty', 'chest_pain', 'lung_cancer']
lung[columns_to_transform_for_lung] = lung[columns_to_transform_for_lung].replace({1: 0, 2: 1, 'YES': 1, 'NO': 0})
lung

# Cell 12: Split features and target
xlung = lung.iloc[:, :-1]
ylung = lung.iloc[:, -1]
xheart = heart.iloc[:, :-1]
yheart = heart.iloc[:, -1]
xdb = db.iloc[:, :-1]
ydb = db.iloc[:, -1]

# Cell 13: Scale heart dataset and convert to NumPy
heart_scaler = MinMaxScaler()
heart_scaled = heart_scaler.fit_transform(xheart)
xheart = np.ascontiguousarray(heart_scaled)
yheart = np.ascontiguousarray(yheart)

# Cell 14: Scale lung dataset and convert to NumPy
lung_scaler = MinMaxScaler()
lung_scaled = lung_scaler.fit_transform(xlung)
xlung = np.ascontiguousarray(lung_scaled)
ylung = np.ascontiguousarray(ylung)

# Cell 15: Scale diabetes dataset and convert to NumPy
db_scaler = MinMaxScaler()
db_scaled = db_scaler.fit_transform(xdb)
xdb = np.ascontiguousarray(db_scaled)
ydb = np.ascontiguousarray(ydb)

# Cell 16: Train-test split and convert to NumPy
xtrainheart, xtestheart, ytrainheart, ytestheart = train_test_split(xheart, yheart, test_size=0.2, random_state=0)
xtrainlung, xtestlung, ytrainlung, ytestlung = train_test_split(xlung, ylung, test_size=0.2, random_state=0)
xtraindb, xtestdb, ytraindb, ytestdb = train_test_split(xdb, ydb, test_size=0.2, random_state=0)

# Convert to C-contiguous NumPy arrays
xtrainheart = np.ascontiguousarray(xtrainheart)
xtestheart = np.ascontiguousarray(xtestheart)
ytrainheart = np.ascontiguousarray(ytrainheart)
ytestheart = np.ascontiguousarray(ytestheart)

xtrainlung = np.ascontiguousarray(xtrainlung)
xtestlung = np.ascontiguousarray(xtestlung)
ytrainlung = np.ascontiguousarray(ytrainlung)
ytestlung = np.ascontiguousarray(ytestlung)

xtraindb = np.ascontiguousarray(xtraindb)
xtestdb = np.ascontiguousarray(xtestdb)
ytraindb = np.ascontiguousarray(ytraindb)
ytestdb = np.ascontiguousarray(ytestdb)

# Cell 17: Visualize class distribution
def plot_class_distribution(y, title, ax):
    sns.countplot(x=y, ax=ax)
    ax.set_title(title)
    ax.set_xlabel('Class')
    ax.set_ylabel('Count')
    for p in ax.patches:
        ax.annotate(f'{int(p.get_height())}', (p.get_x() + p.get_width() / 2., p.get_height()),
                    ha='center', va='baseline', fontsize=10, color='black', xytext=(0, 5),
                    textcoords='offset points')

# Create subplots
fig, axes = plt.subplots(2, 2, figsize=(12, 8))

# Heart dataset
plot_class_distribution(ytrainheart, 'Heart Disease Class Distribution (Training)', axes[0, 0])

# Lung dataset
plot_class_distribution(ytrainlung, 'Lung Cancer Class Distribution (Training)', axes[0, 1])

# Diabetes dataset
plot_class_distribution(ytraindb, 'Diabetes Class Distribution (Training)', axes[1, 0])



plt.tight_layout()
plt.savefig('class_distribution.png')
plt.show()

# Cell 18: Apply SMOTE
smote = SMOTE(random_state=42)

# Heart dataset
print("Heart - Before SMOTE:", pd.Series(ytrainheart).value_counts().to_dict())
xtrainheart_smote, ytrainheart_smote = smote.fit_resample(xtrainheart, ytrainheart)
xtrainheart_smote = np.ascontiguousarray(xtrainheart_smote)
ytrainheart_smote = np.ascontiguousarray(ytrainheart_smote)
print("Heart - After SMOTE:", pd.Series(ytrainheart_smote).value_counts().to_dict())

# Lung dataset
print("Lung - Before SMOTE:", pd.Series(ytrainlung).value_counts().to_dict())
xtrainlung_smote, ytrainlung_smote = smote.fit_resample(xtrainlung, ytrainlung)
xtrainlung_smote = np.ascontiguousarray(xtrainlung_smote)
ytrainlung_smote = np.ascontiguousarray(ytrainlung_smote)
print("Lung - After SMOTE:", pd.Series(ytrainlung_smote).value_counts().to_dict())

# Diabetes dataset
print("Diabetes - Before SMOTE:", pd.Series(ytraindb).value_counts().to_dict())
xtraindb_smote, ytraindb_smote = smote.fit_resample(xtraindb, ytraindb)
xtraindb_smote = np.ascontiguousarray(xtraindb_smote)
ytraindb_smote = np.ascontiguousarray(ytraindb_smote)
print("Diabetes - After SMOTE:", pd.Series(ytraindb_smote).value_counts().to_dict())



# Cell 19: Lung algorithm selection
models = {
    "Logistic Regression": LogisticRegression(max_iter=1000, random_state=42),
    "Random Forest": RandomForestClassifier(n_estimators=100, random_state=42),
    "SVM": SVC(random_state=42),
    "KNN": KNeighborsClassifier(),
    "Gradient Boosting": GradientBoostingClassifier(random_state=42),
    "Naive Bayes": GaussianNB(),
    "Neural Network": MLPClassifier(max_iter=2000, hidden_layer_sizes=(100, 50), learning_rate_init=0.01, random_state=42)
}

print(f"Test set size: {xtestlung.shape[0]} samples")
for name, model in models.items():
    cv_scores = cross_val_score(model, xtrainlung_smote, ytrainlung_smote, cv=5, scoring='accuracy')
    print(f'{name} Cross-Validation Accuracy: {cv_scores.mean():.4f} ± {cv_scores.std():.4f}')

for name, model in models.items():
    model.fit(xtrainlung_smote, ytrainlung_smote)
    predictions = model.predict(xtestlung)
    accuracy = accuracy_score(ytestlung, predictions)
    print(f'{name} Accuracy: {accuracy}')
    precision = precision_score(ytestlung, predictions)
    recall = recall_score(ytestlung, predictions)
    f1 = f1_score(ytestlung, predictions)
    print(f'Precision: {precision}')
    print(f'Recall: {recall}')
    print(f'F1-Score: {f1}')
    print("Confusion Matrix:")
    print(confusion_matrix(ytestlung, predictions))
    print('-------------------------')

